# Required for the agents to think. Without it every turn falls back to
# "<name> pauses, considering their next move..."
OPENROUTER_API_KEY=

# Optional
# DND_INFERENCE_MODEL=openrouter/auto
# DND_INFERENCE_MAX_TOKENS=4096
# DND_INFERENCE_TIMEOUT=60
# DND_MAX_TOOL_ROUNDS=5
# DND_MODEL_CONTEXT_WINDOW=32000
# DND_COMPACTION_KEEP_ROUNDS=3

# Redis (default: redis://localhost:6379/0)
# REDIS_URL=redis://localhost:6379/0

# Signs the session cookie. Set it so restarts don't forget who created which campaign.
# FLASK_SECRET_KEY=change-me
# PORT=8000

# Langfuse tracing (off when unset)
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
